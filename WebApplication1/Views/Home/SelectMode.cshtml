@model WordGame.Models.PlayerModeSelectionViewModel

@{
    ViewData["Title"] = "Choose Player Mode";
}

<style>
    .mode-shell {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mode-card {
        width: min(100%, 760px);
        border-radius: 30px;
        padding: 32px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 22px 60px rgba(0,0,0,.28);
        color: #fff;
    }

    .mode-kicker {
        font-size: .82rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #93c5fd;
        font-weight: 800;
    }

    .mode-title {
        margin-top: 12px;
        margin-bottom: 10px;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 900;
    }

    .mode-text {
        color: #cbd5e1;
        line-height: 1.7;
        margin-bottom: 26px;
    }

    .mode-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
    }

    .mode-option input {
        display: none;
    }

    .mode-label {
        display: block;
        height: 100%;
        padding: 22px;
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(255,255,255,.05);
        cursor: pointer;
        transition: transform .22s ease, border-color .22s ease, background .22s ease;
    }

    .mode-option input:checked + .mode-label {
        border-color: rgba(96,165,250,.85);
        background: linear-gradient(135deg, rgba(37,99,235,.28), rgba(16,185,129,.18));
        transform: translateY(-4px);
    }

    .mode-label:hover {
        transform: translateY(-4px);
        border-color: rgba(255,255,255,.22);
    }

    .mode-name {
        display: block;
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .mode-points {
        color: #dbeafe;
        line-height: 1.7;
    }

    .mode-submit {
        border: none;
        border-radius: 16px;
        padding: 14px 22px;
        background: linear-gradient(135deg, #2563eb, #10b981);
        color: #fff;
        font-weight: 800;
        font-size: 1rem;
        box-shadow: 0 14px 30px rgba(37,99,235,.24);
    }

    .validation {
        color: #fca5a5;
        margin-bottom: 16px;
        font-weight: 700;
        display: block;
    }

    @@media (max-width: 767px) {
        .mode-grid {
            grid-template-columns: 1fr;
        }

        .mode-card {
            padding: 24px;
        }
    }
</style>

<div class="mode-shell">
    <div class="mode-card">
        <div class="mode-kicker">Game Setup</div>
        <h1 class="mode-title">Choose your player mode</h1>
        <p class="mode-text">
            Pick the difficulty before you start. Child mode uses shorter words and extra lives.
            Adult mode uses longer words and more challenging categories.
        </p>

        <form asp-action="SelectMode" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="mode-grid">
                <label class="mode-option">
                    <input asp-for="SelectedMode" type="radio" value="child" />
                    <span class="mode-label">
                        <span class="mode-name">Child Mode</span>
                        <span class="mode-points">4 to 6 letter words, easier categories, and 4 lives for a friendlier experience.</span>
                    </span>
                </label>

                <label class="mode-option">
                    <input asp-for="SelectedMode" type="radio" value="adult" />
                    <span class="mode-label">
                        <span class="mode-name">Adult Mode</span>
                        <span class="mode-points">7 to 10 letter words, broader categories, and 3 lives for a tougher challenge.</span>
                    </span>
                </label>
            </div>

            <span asp-validation-for="SelectedMode" class="validation"></span>
            <button type="submit" class="mode-submit">Continue to Dashboard</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
